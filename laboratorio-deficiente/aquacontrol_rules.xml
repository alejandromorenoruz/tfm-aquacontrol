<!--
  Regla local para AquaControl S.A. (TFM)
  Detecta el mensaje enviado por modbus-sensor cuando observa un codigo de
  funcion Modbus de ESCRITURA hacia OpenPLC sin autenticacion.
  Corresponde a la tecnica MITRE ATT&CK for ICS T0855
  (Unauthorized Command Message).
-->
<group name="modbus,ics,aquacontrol,">
  <rule id="100050" level="10">
    <match>ModbusIDS: Unauthorized write detected</match>
    <description>AquaControl: escritura Modbus no autorizada detectada (posible manipulacion de valvula/bomba via PLC) - T0855</description>
  </rule>
</group>
